{
  "name": "effect-payments-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A vendor-neutral payments core for Effect, with a Stripe implementation",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@thomasfosterau/effect-payments' build && bun run --filter '@thomasfosterau/effect-payments-stripe' build && bun run --filter '@thomasfosterau/effect-payments-airwallex' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages/*/src",
    "lint:fix": "eslint packages/*/src --fix",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "keywords": [
    "effect",
    "payments",
    "stripe",
    "api",
    "typescript"
  ],
  "author": "Thomas Foster",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-stripe.git"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-stripe/issues"
  },
  "homepage": "https://github.com/thomasfosterau/effect-stripe#readme",
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "effect": "^3.10.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "stripe": "^17.6.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
