{
  "name": "@thomasfosterau/effect-stripe",
  "version": "0.0.0",
  "description": "An Effect wrapper around the Stripe API",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./Stripe": {
      "import": "./dist/Stripe.js",
      "types": "./dist/Stripe.d.ts"
    },
    "./Customer": {
      "import": "./dist/Customer.js",
      "types": "./dist/Customer.d.ts"
    },
    "./Product": {
      "import": "./dist/Product.js",
      "types": "./dist/Product.d.ts"
    },
    "./Price": {
      "import": "./dist/Price.js",
      "types": "./dist/Price.d.ts"
    },
    "./PaymentIntent": {
      "import": "./dist/PaymentIntent.js",
      "types": "./dist/PaymentIntent.d.ts"
    },
    "./Subscription": {
      "import": "./dist/Subscription.js",
      "types": "./dist/Subscription.d.ts"
    },
    "./Account": {
      "import": "./dist/Account.js",
      "types": "./dist/Account.d.ts"
    },
    "./AccountLink": {
      "import": "./dist/AccountLink.js",
      "types": "./dist/AccountLink.d.ts"
    },
    "./Person": {
      "import": "./dist/Person.js",
      "types": "./dist/Person.d.ts"
    },
    "./ExternalAccount": {
      "import": "./dist/ExternalAccount.js",
      "types": "./dist/ExternalAccount.d.ts"
    },
    "./Transfer": {
      "import": "./dist/Transfer.js",
      "types": "./dist/Transfer.d.ts"
    },
    "./Topup": {
      "import": "./dist/Topup.js",
      "types": "./dist/Topup.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "effect",
    "stripe",
    "payments",
    "api",
    "typescript"
  ],
  "author": "Thomas Foster",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-stripe.git"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-stripe/issues"
  },
  "homepage": "https://github.com/thomasfosterau/effect-stripe#readme",
  "peerDependencies": {
    "effect": "^3.0.0"
  },
  "dependencies": {
    "stripe": "^17.6.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "effect": "^3.10.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
