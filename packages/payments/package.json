{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-payments",
  "version": "0.1.0",
  "description": "A vendor-neutral payments core for Effect",
  "keywords": [
    "api",
    "effect",
    "payments",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-finance#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-finance/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-finance.git",
    "directory": "packages/payments"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Customer": {
      "types": "./dist/Customer.d.ts",
      "default": "./dist/Customer.js"
    },
    "./Product": {
      "types": "./dist/Product.d.ts",
      "default": "./dist/Product.js"
    },
    "./Price": {
      "types": "./dist/Price.d.ts",
      "default": "./dist/Price.js"
    },
    "./PaymentIntent": {
      "types": "./dist/PaymentIntent.d.ts",
      "default": "./dist/PaymentIntent.js"
    },
    "./Subscription": {
      "types": "./dist/Subscription.d.ts",
      "default": "./dist/Subscription.js"
    },
    "./Refund": {
      "types": "./dist/Refund.d.ts",
      "default": "./dist/Refund.js"
    },
    "./CheckoutSession": {
      "types": "./dist/CheckoutSession.d.ts",
      "default": "./dist/CheckoutSession.js"
    },
    "./BillingPortal": {
      "types": "./dist/BillingPortal.d.ts",
      "default": "./dist/BillingPortal.js"
    },
    "./Enumeration": {
      "types": "./dist/Enumeration.d.ts",
      "default": "./dist/Enumeration.js"
    },
    "./IdempotencyKey": {
      "types": "./dist/IdempotencyKey.d.ts",
      "default": "./dist/IdempotencyKey.js"
    },
    "./Money": {
      "types": "./dist/Money.d.ts",
      "default": "./dist/Money.js"
    },
    "./Page": {
      "types": "./dist/Page.d.ts",
      "default": "./dist/Page.js"
    },
    "./PaymentsError": {
      "types": "./dist/PaymentsError.d.ts",
      "default": "./dist/PaymentsError.js"
    },
    "./Stub": {
      "types": "./dist/Stub.d.ts",
      "default": "./dist/Stub.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
